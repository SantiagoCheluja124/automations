    {
      "parameters": {
        "jsCode": "const content = $('Webhook').item.json.body.content || '';\n\n// Extraer la URL del patrón de Kapso\nconst urlMatch = content.match(/URL:\\s*(https?:\\/\\/\\S+)/i);\nconst imageUrl = urlMatch ? urlMatch[1] : null;\n\n// Extraer el nombre del archivo\nconst nameMatch = content.match(/Image attached \\(([^)]+)\\)/i);\nconst fileName = nameMatch ? nameMatch[1] : 'image.jpeg';\n\n// Detectar el tipo MIME\nconst typeMatch = content.match(/Type:\\s*(image\\/\\w+)/i);\nconst mimeType = typeMatch ? typeMatch[1] : 'image/jpeg';\n\nif (!imageUrl) {\n  throw new Error('No se pudo extraer la URL de la imagen de Kapso: ' + content);\n}\n\nreturn [{\n  json: {\n    kapso_image_url: imageUrl,\n    kapso_file_name: fileName,\n    kapso_mime_type: mimeType,\n    // Simulamos el formato que espera el resto del flujo\n    body: {\n      ...$('Webhook').item.json.body,\n      conversation: {\n        ...$('Webhook').item.json.body.conversation,\n        messages: [\n          {\n            ...$('Webhook').item.json.body.conversation.messages[0],\n            attachments: [{\n              file_type: 'image',\n              data_url: imageUrl\n            }]\n          }\n        ]\n      }\n    }\n  }\n}];"
      },
