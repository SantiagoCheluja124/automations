    {
      "parameters": {
        "jsCode": "// ✅ Sintaxis correcta para nodo Code en n8n\nconst item = $('Webhook').first().json;\n\n// Leer el mensaje desde la ruta correcta del webhook\nconst rawMessage = (\n  item?.body?.conversation?.messages?.[0]?.content ||\n  item?.body?.processed_message_content ||\n  item?.body?.message ||\n  item?.body?.content ||\n  item?.processed_message_content ||\n  item?.message ||\n  item?.content ||\n  ''\n).toString().trim();\n\n// ---------- helper de normalización ----------\nfunction normalize(s) {\n  return s\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[¡!¿?.,;:\"'`´()\\[\\]{}]/g, '')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nconst msgNorm = normalize(rawMessage);\n\n// ---------- 1. Marcadores de media: jamás son quick reply ----------\nconst tieneMarcadorMedia =\n  rawMessage.includes('[Comprobante de transferencia') ||\n  rawMessage.includes('[Imagen recibida') ||\n  rawMessage.includes('[Texto del cliente]') ||\n  rawMessage.includes('[Audio');\n\nif (tieneMarcadorMedia) {\n  return [{\n    json: {\n      ...item,\n      quick_reply_action: 'continue',\n      quick_reply_intent: null,\n      quick_reply_motivo: 'tiene marcador de media',\n    },\n  }];\n}\n\n// ---------- 2. Quick replies que CIERRAN la conversación ----------\nconst qr_close = new Set([\n  'hoy pago',\n  'manana pago',\n  'gracias por el aviso',\n  'todo bien',\n  'manana hago mi pago',\n  'gracias todo bien',\n  'pagare a tiempo',\n  'continuar'\n]);\n\nif (qr_close.has(msgNorm)) {\n  return [{\n    json: {\n      ...item,\n      quick_reply_action: 'close',\n      quick_reply_intent: null,\n      quick_reply_motivo: `boton QR close: \"${msgNorm}\"`,\n    },\n  }];\n}\n\n// ---------- 3. Texto corto de acuse (close) ----------\n// Filtro por palabras, no por caracteres, para evitar falsos positivos\nconst wordCount = msgNorm.split(' ').filter(w => w.length > 0).length;\nconst esCorto = wordCount <= 3;\n\n// const texto_close = new Set([\n//   'ok', 'okay', 'oki', 'okey', 'okas',\n//   'listo', 'perfecto', 'excelente', 'entendido', 'enterado',\n//   'de acuerdo', 'gracias', 'muchas gracias', 'ok gracias', 'okay gracias',\n//   'perfecto gracias', 'mil gracias', 'gracias por avisar', 'gracias por el aviso',\n//   'si gracias', 'claro gracias', 'ok muchas gracias',\n// ]);\n\n// if (esCorto && texto_close.has(msgNorm)) {\n//   return [{\n//     json: {\n//       ...item,\n//       quick_reply_action: 'close',\n//       quick_reply_intent: null,\n//       quick_reply_motivo: `acuse corto: \"${msgNorm}\"`,\n//     },\n//   }];\n// }\n\n// ---------- 4. Quick replies con intent pre-clasificado (continue) ----------\nconst qr_con_intent = {\n  // PAYMENT_HELP\n  'ayuda con mi pago':    'PAYMENT_HELP',\n  'ayuda pago':           'PAYMENT_HELP',\n  'ayuda, hoy pago':      'PAYMENT_HELP',\n  'ayuda, manana pago':   'PAYMENT_HELP',\n  'ayuda hoy pago':       'PAYMENT_HELP',\n  'ayuda pago manana':    'PAYMENT_HELP',\n  'ayuda pago en 2 dias': 'PAYMENT_HELP',\n  'retomar pagos':        'PAYMENT_HELP',\n  'opciones de pago':     'PAYMENT_HELP',\n  'ayuda con mi deuda':   'PAYMENT_HELP',\n  'quiero retomar pagos': 'PAYMENT_HELP',\n  'quiero pagar':         'PAYMENT_HELP',\n  'problemas para pagar': 'PAYMENT_HELP',\n  // SKIP_PAYMENT\n  'ayuda para aplazar':   'SKIP_PAYMENT',\n  'ayuda aplazamiento':   'SKIP_PAYMENT',\n  'ayuda aplazar':        'SKIP_PAYMENT',\n  'ayuda oferta aplazar': 'SKIP_PAYMENT',\n  // PROMISE_TO_PAY\n  'promesa de pago':      'PROMISE_TO_PAY',\n  'ayuda con promesa':    'PROMISE_TO_PAY',\n  // DISCOUNT\n  'hoy pago con oferta':  'DISCOUNT',\n  'ayuda con oferta':     'DISCOUNT',\n  'ayuda ofer':           'DISCOUNT',\n  // RENEWAL\n  'activar renovacion':   'RENEWAL',\n  'disponer ahora':       'RENEWAL',\n};\n\nconst intentMatch = qr_con_intent[msgNorm];\nif (intentMatch) {\n  return [{\n    json: {\n      ...item,\n      quick_reply_action: 'continue',\n      quick_reply_intent: intentMatch,\n      quick_reply_motivo: `QR con intent: \"${msgNorm}\" → ${intentMatch}`,\n    },\n  }];\n}\n\n// ---------- 5. Default: pasa al orquestador sin intent ----------\nreturn [{\n  json: {\n    ...item,\n    quick_reply_action: 'continue',\n    quick_reply_intent: null,\n    quick_reply_motivo: 'texto libre — sin match de QR',\n  },\n}];"
      },
