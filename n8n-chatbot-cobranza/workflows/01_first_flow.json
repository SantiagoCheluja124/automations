    {
      "parameters": {
        "jsCode": "const whisperResponse = $input.first().json;\nconst transcripcion = (whisperResponse.text || '').trim();\nconst captionUsuario = ($('Webhook').item.json.body.content || '').trim();\n\nlet mensajeFinal = transcripcion.length > 0\n  ? `[Audio transcrito] ${transcripcion}`\n  : '[Audio recibido pero no se pudo transcribir]';\n\nif (captionUsuario) {\n  mensajeFinal += `\\n[Texto del cliente] ${captionUsuario}`;\n}\n\nreturn [{\n  json: {\n    message: mensajeFinal,\n    transcripcion_raw: transcripcion\n  }\n}];"
      },
      "id": "0e3d0175-7a5a-4738-9fac-81c91c7b52a7",
      "name": "Inyectar Transcripción",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1600,
        496
      ]
    },
    {
      "parameters": {
        "jsCode": "// CONSTRUIR PROMPT OCR PARA COMPROBANTE DE TRANSFERENCIA\nconst webhookBody = $('Webhook').item.json.body;\nconst captionUsuario = (webhookBody.content || '').trim();\n\n// Imagen ya descargada por HTTP Request anterior\nconst binaryData = $input.first().binary.data;\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst imageBase64 = buffer.toString('base64');\nconst mediaType = $input.first().binary.data.mimeType || 'image/jpeg';\n\n// System prompt: especialista en lectura de comprobantes\nconst systemPrompt = `You are an OCR assistant specialized in reading bank transfer receipts (Mexican banks: BBVA, Santander, Banorte, Banco Azteca, HSBC, Citibanamex, Scotiabank, etc.).\n\nFirst, determine if the image is a bank transfer receipt or not.\n\nIf it is NOT a bank transfer receipt, return ONLY this JSON:\n{\"is_receipt\": false, \"image_description\": \"<brief description in Spanish>\"}\n\nIf it IS a bank transfer receipt, return ONLY this JSON with the extracted data:\n{\n  \"is_receipt\": true,\n  \"origin_bank\": \"<string or null>\",\n  \"origin_account\": \"<string or null>\",\n  \"destination_bank\": \"<string or null>\",\n  \"destination_account\": \"<string or null>\",\n  \"beneficiary\": \"<string or null>\",\n  \"datetime\": \"<YYYY-MM-DD HH:MM or null>\",\n  \"amount\": <number or null>,\n  \"fee\": <number or null>,\n  \"concept\": \"<string or null>\",\n  \"reference\": \"<string or null>\",\n  \"transaction_id\": \"<string or null>\",\n  \"tracking_key\": \"<string or null>\",\n  \"transaction_type\": \"<SPEI | TRANSFER | DEPOSIT | OTHER or null>\",\n  \"low_confidence_fields\": [\"<field_name>\", ...]\n}\n\nSTRICT RULES:\n- datetime format: YYYY-MM-DD HH:MM (24hr, no a.m./p.m., no month names)\n- amounts: numeric only, no $ symbol, no thousands separator (use 1234.56 not 1,234.56)\n- if a field is not visible or unreadable, use null (NOT empty string, NOT 0)\n- low_confidence_fields: array of field names where you had to guess due to blur, cropping, or partial visibility\n- Return ONLY the raw JSON, no explanation, no markdown backticks`;\n\n// User message: incluye el caption del cliente si lo hubo\nconst userText = captionUsuario\n  ? `Extract the data from this receipt.\\n\\nNote: the customer wrote this along with the image: \"${captionUsuario}\"`\n  : 'Extract the data from this receipt.';\n\n// Body para Claude API con base64\nconst claudeBody = {\n  model: \"claude-sonnet-4-6\",\n  max_tokens: 1024,\n  system: systemPrompt,\n  messages: [{\n    role: \"user\",\n    content: [\n      {\n        type: \"image\",\n        source: {\n          type: \"base64\",\n          media_type: mediaType,\n          data: imageBase64\n        }\n      },\n      { type: \"text\", text: userText }\n    ]\n  }]\n};\n\nreturn [{\n  json: {\n    sender_id: webhookBody.sender.id,\n    sender_phone: webhookBody.sender.phone_number,\n    sender_name: webhookBody.sender.name,\n    conversation_id: webhookBody.conversation.id,\n    caption_usuario: captionUsuario,\n    claude_request_body: claudeBody\n  }\n}];"
      },
      "id": "1986000d-bba2-49c5-9204-91d38f8bc725",
      "name": "Construir Prompt Vision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1824,
        704
      ]
    },
    {
      "parameters": {
        "jsCode": "const claudeResponse = $input.first().json;\nconst rawText = (claudeResponse.content?.[0]?.text || '').trim();\nconst captionUsuario = $('Construir Prompt Vision').first().json.caption_usuario || '';\n\n// Limpia posibles fences de markdown\nconst cleaned = rawText\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    is_receipt: false,\n    image_description: '[error parseando respuesta de Claude]',\n    _parse_error: true,\n    _raw_text: rawText\n  };\n}\n\nconst isReceipt = parsed.is_receipt === true || parsed.is_receipt === 'true';\n\nlet mensajeFinal;\nif (isReceipt) {\n  const lines = [\n    `[Comprobante de transferencia recibido]`,\n    `- Banco origen: ${parsed.origin_bank ?? 'no leído'}`,\n    `- Cuenta origen: ${parsed.origin_account ?? 'no leído'}`,\n    `- Banco destino: ${parsed.destination_bank ?? 'no leído'}`,\n    `- CLABE destino: ${parsed.destination_account ?? 'no leído'}`,\n    `- Beneficiario: ${parsed.beneficiary ?? 'no leído'}`,\n    `- Monto: ${parsed.amount ?? 'no leído'}`,\n    `- Fecha: ${parsed.datetime ?? 'no leído'}`,\n    `- Concepto: ${parsed.concept ?? 'sin concepto'}`,\n    `- Referencia: ${parsed.reference ?? 'no leído'}`,\n    `- Folio: ${parsed.transaction_id ?? 'no leído'}`,\n    `- Clave de rastreo: ${parsed.tracking_key ?? 'no leído'}`,\n    `- Tipo: ${parsed.transaction_type ?? 'no especificado'}`,\n  ];\n  if (parsed.low_confidence_fields?.length > 0) {\n    lines.push(`- Campos con baja confianza: ${parsed.low_confidence_fields.join(', ')}`);\n  }\n  mensajeFinal = lines.join('\\n');\n} else {\n  mensajeFinal = `[Imagen recibida que NO es comprobante: ${parsed.image_description ?? 'sin descripción'}]`;\n}\n\nif (captionUsuario) {\n  mensajeFinal += `\\n[Texto del cliente] ${captionUsuario}`;\n}\n\nreturn [{\n  json: {\n    message: mensajeFinal,\n    receipt_data: parsed\n  }\n}];"
      },
