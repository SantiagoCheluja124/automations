    {
      "parameters": {
        "jsCode": "const now = $now.setZone('America/Mexico_City');\nconst h = now.hour;\nconst m = now.minute;\nconst dow = now.weekday;\nconst mins = h * 60 + m;\n\n// === HORARIOS DE ATENCIÓN ===\nconst enHorario = (() => {\n  if (dow >= 1 && dow <= 5) return mins >= 480 && mins < 1200; // L-V 8am-8pm\n  if (dow === 6)            return mins >= 540 && mins < 840;  // Sab 9am-2pm\n  return false;\n})();\n\nif (enHorario) {\n  // Estamos en horario pero no hay agente online — NO forzamos, dejamos pasar\n  // (esto no debería pasar normalmente, pero si pasa, terminamos sin asignar)\n  return [{ json: { asignado: false, motivo: 'en_horario_sin_agente_disponible' } }];\n}\n\n// Fuera de horario: forzamos el primer agente aunque esté offline\nconst agentes = [85, 86, 12, 23, 88, 42];\nconst assignee_id = agentes[Math.floor(Math.random() * agentes.length)];\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    assignee_id,\n    asignado: true,\n    forzado_offline: true,\n    motivo: 'fuera_de_horario_asignado_offline'\n  }\n}];"
