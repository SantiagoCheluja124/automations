        "jsCode": "const messages = $json.output.messages || [];\n\nconst chunks = messages.map((content, i) => {\n  // primer mensaje sin delay\n  if (i === 0) {\n    return { content, delay_seconds: 0.2 };\n  }\n\n  const base = Math.max(800, Math.min(2500, content.length * 25));\n  const jitter = base * 0.2 * (Math.random() * 2 - 1);\n  const delay_seconds = (base + jitter) / 1000;\n\n  return { content, delay_seconds: Math.round(delay_seconds * 100) / 100 };\n});\n\nreturn chunks.map(c => ({ json: c }));\n\n"
