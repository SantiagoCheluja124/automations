    {
      "parameters": {
        "jsCode": "const humanPool = [85, 86, 12, 23, 88, 42];\n\n// el GET regresa un array de agentes (un item por agente en n8n)\nconst list = $('get_agentes').all().map(i => i.json);\n\nconst online = list\n  .filter(a => humanPool.includes(a.id) && a.availability_status === 'online')\n  .map(a => a.id);\n\nconst pool = online.length > 0 ? online : humanPool;   // fallback: nadie online → random igual\nconst selected = pool[Math.floor(Math.random() * pool.length)];\n\nreturn [{\n  json: {\n    //$('Webhook').first().json,   // conservamos la conversación original\n    assignee_id: selected,\n    online_count: online.length     // útil para debug / futura métrica\n  }\n}];"
      },
