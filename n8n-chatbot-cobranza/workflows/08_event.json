    {
      "parameters": {
        "jsCode": "const now = $now.setZone('America/Mexico_City');\nconst h = now.hour;\nconst m = now.minute;\nconst dow = now.weekday;\nconst mins = h * 60 + m;\n\n// === HORARIOS DE ATENCIÓN ===\nconst enHorario = (() => {\n  if (dow >= 1 && dow <= 5) return mins >= 480 && mins < 1200; // L-V 8am-8pm\n  if (dow === 6)            return mins >= 540 && mins < 840;  // Sab 9am-2pm\n  return false;\n})();\n\nif (enHorario) {\n  // Estamos en horario pero no hay agente online — NO forzamos, dejamos pasar\n  // (esto no debería pasar normalmente, pero si pasa, terminamos sin asignar)\n  return [{ json: { asignado: false, motivo: 'en_horario_sin_agente_disponible' } }];\n}\n\n// Fuera de horario: forzamos el primer agente aunque esté offline\nconst agentes = [85, 86, 12, 23, 88, 42];\nconst assignee_id = agentes[Math.floor(Math.random() * agentes.length)];\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    assignee_id,\n    asignado: true,\n    forzado_offline: true,\n    motivo: 'fuera_de_horario_asignado_offline'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1728,
        -976
      ],
      "id": "63edd807-2e8f-4025-bf9f-d0b3ee4a5a3d",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Lee el texto crudo que devuelve el AI Agent\nconst item = $input.first().json;\n\n// El AI Agent de n8n mete la respuesta en .output (string o objeto)\nconst rawOutput = item.output;\n\nlet parsed;\n\n// Intento 1: ya es objeto con las keys correctas\nif (rawOutput && typeof rawOutput === 'object' && Array.isArray(rawOutput.messages)) {\n  parsed = rawOutput;\n}\n\n// Intento 2: es string — extraer el JSON de adentro\nif (!parsed) {\n  const str = typeof rawOutput === 'string' \n    ? rawOutput \n    : JSON.stringify(rawOutput ?? item);\n  \n  // Buscar el primer { y el último } para extraer solo el JSON\n  const start = str.indexOf('{');\n  const end = str.lastIndexOf('}');\n  \n  if (start !== -1 && end !== -1 && end > start) {\n    try {\n      parsed = JSON.parse(str.slice(start, end + 1));\n    } catch(e) {\n      parsed = null;\n    }\n  }\n}\n\n// Fallback seguro si todo falla\nif (!parsed || !Array.isArray(parsed.messages) || parsed.messages.length === 0) {\n  parsed = {\n    needs_query: false,\n    query: \"\",\n    escalate_to_human: false,\n    cerrar_conversacion: false,\n    messages: [\"Un momento, enseguida te ayudo 🙏\"],\n    reasoning: \"fallback por error de parseo\"\n  };\n}\n\n// Sanitizar tipos\nparsed.needs_query = parsed.needs_query === true;\nparsed.escalate_to_human = parsed.escalate_to_human === true;\nparsed.cerrar_conversacion = parsed.cerrar_conversacion === true;\nparsed.query = typeof parsed.query === 'string' ? parsed.query : \"\";\nparsed.messages = parsed.messages.map(m => String(m)).filter(m => m.length > 0);\n\nreturn [{ json: { output: parsed } }];"
      },
