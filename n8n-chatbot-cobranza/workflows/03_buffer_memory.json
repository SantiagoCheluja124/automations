    {
      "parameters": {
        "jsCode": "// ========================================\n// CONSOLIDAR MENSAJES DEL BUFFER\n// ========================================\n// Toma todos los mensajes acumulados en Redis\n// y los concatena para pasarlos al orquestador\n// ========================================\n\nconst originalData = $('Start Buffer').item.json;\nconst bufferData = $('Get After Data').item.json;\n\n// La lista viene en propertyName como array de strings JSON\nconst rawMessages = bufferData.propertyName || [];\n\n// Parsear cada mensaje stringificado\nconst messages = rawMessages.map(raw => {\n  try {\n    return typeof raw === 'string' ? JSON.parse(raw) : raw;\n  } catch (e) {\n    return { message: String(raw), parse_error: true };\n  }\n});\n\n// Concatenar todos los textos con separador\nconst consolidatedMessage = messages\n  .map(m => m.message || '')\n  .filter(m => m.length > 0)\n  .join(' ');\n\n// Consolidar attachments de todos los mensajes\nconst allAttachments = messages.flatMap(m => m.attachments || []);\nconst hasImage = allAttachments.some(a => a.file_type === 'image');\n\n// Devolver el paquete completo para el siguiente workflow\nreturn {\n  json: {\n    // === IDENTIFICACIÓN DEL CLIENTE ===\n    sender_id: originalData.sender_id,\n    sender_name: originalData.sender_name,\n    user_identifier: originalData.user_identifier,\n    phone_number: originalData.phone_number,\n\n    // === IDENTIFICACIÓN DE LA CONVERSACIÓN ===\n    conversation_id: originalData.conversation_id,\n    account_id: originalData.account_id,\n    inbox_id: originalData.inbox_id,\n\n    // === MENSAJE CONSOLIDADO ===\n    message: consolidatedMessage,\n    message_count: messages.length,\n    messages_history: messages,\n\n    // === CONTEXTO DE CONVERSACIÓN ===\n    historial: originalData.historial,\n    total_mensajes: originalData.total_mensajes,\n\n    // === METADATA ===\n    last_message_id: originalData.message_id,\n    last_timestamp: originalData.timestamp,\n    consolidated_at: new Date().toISOString(),\n    from_buffer: true\n  }\n};\n"
      },
