    {
      "parameters": {
        "jsCode": "const team = $input.first().json.assignment_team;\n\nconst agents  = [1, 2, 3, 4, 5, 6, 99];\nconst weights = [0, 0, 0, 0, 0, 0, 1.0];// suma = 1.0\n\nconst r = Math.random();\nlet acc = 0;\nlet selected = agents[agents.length - 1]; // fallback\n\nfor (let i = 0; i < agents.length; i++) {\n  acc += weights[i];\n  if (r <= acc) {\n    selected = agents[i];\n    break;\n  }\n}\n\nreturn [{ json: { \n  assignee_id: selected\n}}];"
      },
