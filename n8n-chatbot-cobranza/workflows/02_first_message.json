    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with\n            contact_users as (\n                select\n                    u.id as user_id,\n                    upper(u.curp) as curp,\n                    upper(u.first_name) as first_name,\n                    upper(u.middle_name) as middle_name,\n                    upper(u.last_name_1) as last_name_1,\n                    upper(u.last_name_2) as last_name_2,\n                    u.primary_phone_number,\n                    lower(u.primary_email) as primary_email\n                from\n                    users as u\n                where\n                    primary_phone_number = REPLACE('{{ $node[\"Webhook\"].json[\"phone-number\"] }}', '+521', '+52')\n            ),\n            last_application_id as (\n                select\n                    a.user_id,\n                    a.id as application_id,\n                    date(a.created_at at time zone 'cst') as application_date,\n                    a.application_type,\n                    a.credit_check_status,\n                    a.verification_status,\n                    a.process_status,\n                    'completed' as user_clabe_status,\n                    (CASE WHEN a.signature IS NOT NULL THEN 1 ELSE 0 END)::INT AS signature,\n                    row_number() over (partition by a.user_id order by a.created_at desc) as rn\n                from\n                    applications as a\n                inner join\n                    contact_users as cu on a.user_id = cu.user_id\n            ),\n            last_clabe_payprovider as (\n                select\n                    ac.user_id,\n                    ac.clabe,\n                    row_number() over (partition by ac.user_id order by ac.created_at desc) as rn\n                from\n                    payprovider_customers as ac\n                inner join\n                    contact_users as cu on ac.user_id = cu.user_id\n            ),\n            last_loan_id as (\n                select\n                    l.user_id,\n                    l.id as loan_id,\n                    date(l.created_at at time zone 'cst') as loan_date,\n                    l.loan_status,\n                    lsp.skip_payment_counter,\n                    lsp.skip_payment_limit,\n                    ld.disbursal_date,\n                    ld.payprovider_metadata ->>'url' as cep_url,\n                    case when ld.disbursal_status = 'SENT' THEN 'sent' when ld.disbursal_status is null then 'to be disbursed' else 'failed' end as disbursal_status,\n                    row_number() over (partition by l.user_id order by l.created_at desc, ld.updated_at desc) as rn\n                from\n                    loans as l\n                left join\n                    loan_skip_payments as lsp on l.id = lsp.loan_id\n                left join\n                    loan_disbursals as ld on l.id = ld.loan_id and ld.disbursal_type = 'ONLINE'\n                inner join\n                    contact_users as cu on l.user_id = cu.user_id\n\n                where l.loan_status not in ('CANCELED', 'TESTING')\n            )\n        select\n            cu.*,\n            lai.application_id,\n            to_char(lai.application_date, 'YYYY-MM-DD') as application_date,\n            lai.application_type,\n            lai.credit_check_status,\n            lai.verification_status,\n            lai.process_status,\n            lai.user_clabe_status,\n            --lli.loan_id,\n            null as loan_id,\n            lli.loan_status,\n            to_char(lli.disbursal_date, 'YYYY-MM-DD') as disbursal_date,\n            lli.cep_url,\n            lli.disbursal_status,\n            lca.clabe as user_clabe,\n            lli.skip_payment_counter,\n            lli.skip_payment_limit,\n            lai.signature\n            ,lm.loan_number\n            ,lm.is_paid_off\n\n        from\n            contact_users as cu\n        left join   \n            last_application_id as lai on cu.user_id = lai.user_id and lai.rn = 1\n        left join\n            last_clabe_payprovider as lca on cu.user_id = lca.user_id and lca.rn = 1\n        left join\n            last_loan_id as lli on cu.user_id = lli.user_id and lli.rn = 1\n        left join \n        \tloan_master as lm on lm.loan_id = lli.loan_id",
        "options": {}
      },
