    {
      "parameters": {
        "jsCode": "// IDs de los agentes que queremos monitorear\nconst AGENT_IDS = [\n  1, 2, 3, 4, 5, 6,\n  //99,  // Agente 9\n  //8,  // Agente 8\n];\n\nconst checkedAt = DateTime.now().setZone('America/Mexico_City').toISO();\n\n\nconst agents = $input.all()\n  .map(item => item.json)\n  .filter(agent => AGENT_IDS.includes(agent.id))\n  .map(agent => ({\n    json: {\n      agent_id: agent.id,\n      name: agent.name,\n      status: agent.availability_status, // online | busy | offline\n      checked_at: checkedAt,\n    }\n  }));\n\nreturn agents;"
      },
