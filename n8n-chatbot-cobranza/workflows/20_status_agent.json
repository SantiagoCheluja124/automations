    {
      "parameters": {
        "jsCode": "// Estado actual: viene del Code de normalización\nconst current = $('Code in JavaScript').all().map(i => i.json);\n\n// Estado previo: filas de la hoja estado_actual\nconst prevItems = $input.all()\n  .map(i => i.json)\n  .filter(r => r.agent_id !== undefined && r.agent_id !== '');\n\nconst prevMap = {};\nfor (const row of prevItems) {\n  prevMap[String(row.agent_id)] = row.status;\n}\n\n// Solo agentes cuyo estado cambió\nconst changes = current\n  .filter(a => prevMap[String(a.agent_id)] !== a.status)\n  .map(a => ({\n    json: {\n      agent_id: a.agent_id,\n      name: a.name,\n      from_status: prevMap[String(a.agent_id)] ?? null,\n      to_status: a.status,\n      changed_at: a.checked_at,\n    }\n  }));\n\nreturn changes;"
      },
