    },
    {
      "parameters": {
        "jsCode": "// Agentes y sus pesos (mismos que en Python)\nconst agents = [1, 4, 6, 5];\nconst weights = [0.34, 0.01, 0.40, 0.25];\n\n// Selección por peso acumulado\nconst total = weights.reduce((a, b) => a + b, 0);\nlet r = Math.random() * total;\nlet selected = agents[agents.length - 1];\n\nfor (let i = 0; i < agents.length; i++) {\n  r -= weights[i];\n  if (r <= 0) {\n    selected = agents[i];\n    break;\n  }\n}\n\nreturn [{ json: { assignee_id: selected } }];"
      },
