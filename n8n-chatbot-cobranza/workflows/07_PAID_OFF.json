{
  "name": "PAID_OFF",
  "nodes": [
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH tbd AS (\n    SELECT\n        json_array_elements(loan_options::json) AS loan_options,\n        row_number() OVER (PARTITION BY o.user_id ORDER BY o.created_at DESC) AS rn\n    FROM offers AS o\n    WHERE user_id = '{{ $('Webhook').item.json.user_identifier }}'\n)\nSELECT\n    MAX(((loan_options->>'loan_amount')::numeric)/100)::int AS max_loan_amount,\n    MAX(((loan_options->>'loan_term')::numeric))::int AS weeks,\n    MAX(((loan_options->>'booking_fee')::numeric)/100)::int AS booking_fee,\n    MAX(((loan_options->>'payment_amount')::numeric)/100)::int AS weekly_payment\nFROM tbd\nWHERE rn = 1;",
        "options": {}
      },
