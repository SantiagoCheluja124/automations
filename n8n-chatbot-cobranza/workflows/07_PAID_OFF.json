    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHATWOOT_URL }}/api/v1/accounts/{{ $env.CHATWOOT_ACCOUNT_ID }}/conversations/{{ $node[\"Webhook\"].json[\"conversation_id\"] }}/labels",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"labels\": {{ JSON.stringify($json.labels) }}\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        640,
        -160
      ],
      "id": "564c85fe-d842-44bb-96a4-b3eff71b3980",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "// MERGE DE ETIQUETAS\n// Conserva manuales + agrega las del bot\nconst armar = $('armar_etiquetas').item.json;\nconst nuevas = armar.labels_to_apply || [];\nconst ownedByBot = armar.bot_owned_labels || [];\n\nconst respuestaChatwoot = $('get_etiquetas_actuales').item.json;\nconst existentes = respuestaChatwoot.payload || [];\n\n// Manuales = las que NO están en el catálogo del bot\nconst manuales = existentes.filter(l => !ownedByBot.includes(l));\n\n// Final = manuales preservadas + nuevas del bot (dedup)\nconst final = [...new Set([...manuales, ...nuevas])];\n\nreturn [{\n  json: {\n    ...$json,\n    labels: final,\n    labels_preserved_manual: manuales,\n    labels_added_by_bot: nuevas\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -160
      ],
      "id": "204b5647-c278-4646-b918-5d8af4acdf9f",
      "name": "merge_etiquetas"
    },
    {
      "parameters": {
        "jsCode": "const daily = $('get_daily_collections').item.json;\nconst user = $('Webhook').item.json; // viene de CLASSIFICATION con datos del query principal\n\nconst labels = [];\n\n// === Estatus de cobranza (mutuamente excluyente) ===\nconst seg = (daily.coll_segment || '').toUpperCase();\nif (seg === 'REMINDER') {\n  labels.push('reminder');\n} else if (seg === 'PAYDAY') {\n  labels.push('payday');\n} else if (seg === 'DEFAULTER') {\n  labels.push('defaulter');\n  // DPD específico\n  const dpd = -daily.days_to_due_date; // si days_to_due_date = -2, dpd = 2\n  if (dpd === 1) labels.push('1_dpd');\n  else if (dpd === 2) labels.push('2_dpd');\n  else if (dpd === 3) labels.push('3_dpd');\n}\n\n// === Tipo de préstamo (mutuamente excluyente) ===\nconst loanType = (daily.loan_type || daily.application_type || '').toUpperCase();\nif (loanType === 'FT' || loanType === 'NEW') {\n  labels.push('ft');\n} else if (loanType === 'TU' || loanType === 'TOPUP') {\n  labels.push('tu');\n}\n\n// === Estados especiales (combinables) ===\nif (daily.active_promise) labels.push('promise_active');\nif (daily.refinanced) labels.push('refinance');\n\n// Skip: ajustar según defina el equipo de cobranza\nif (daily.skip_in_last_7_days || daily.pending_skip_activation) {\n  labels.push('skip_active');\n}\n\n// recent_disbursed solo si tienes disbursal_date en este contexto\n// (puede venir del query principal, no de daily)\n\nreturn [{ json: { ...$json, labels_to_apply: labels } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        -160
      ],
      "id": "877eb431-1d63-4292-8c0e-ac33d7d0d0e5",
      "name": "armar_etiquetas"
    },
    {
      "parameters": {
        "url": "={{ $env.CHATWOOT_URL }}/api/v1/accounts/{{ $env.CHATWOOT_ACCOUNT_ID }}/conversations/{{ $node[\"Webhook\"].json[\"conversation_id\"] }}/labels",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        272,
        -160
      ],
      "id": "c9489a11-fabc-48d9-9988-8775811d00a9",
      "name": "get_etiquetas_actuales"
    },
    {
      "parameters": {
        "jsCode": "\n// Datos de la oferta del warehouse de producción\nconst offer = $input.first().json;\nconst baseContext = $('Webhook').item.json.base_context;\n\n// Verificar si hay oferta disponible\nconst hasOffer = offer && offer.max_loan_amount && offer.max_loan_amount > 0;\n\nlet contextBlock;\n\nif (hasOffer) {\n  const totalToPay = offer.weeks * offer.weekly_payment;\n  const totalToReceive = offer.max_loan_amount - offer.booking_fee;\n  \n  contextBlock = `CONTEXTO DEL CLIENTE (préstamo anterior LIQUIDADO)\n\nIdentidad:\n- Nombre: ${baseContext.first_name || 'no disponible'}\n- User ID: ${baseContext.user_id}\n- Email: ${baseContext.primary_email || 'no disponible'}\n- Último préstamo: ${baseContext.loan_number || 'n/a'} (liquidado)\n\nOferta de renovación disponible:\n- Monto máximo del nuevo préstamo: $${offer.max_loan_amount}\n- Plazo: ${offer.weeks} semanas\n- Pago semanal: $${offer.weekly_payment}\n- Total a pagar: $${totalToPay}\n- Booking fee (se transforma en cashback): $${offer.booking_fee}\n- Total a recibir (depositado): $${totalToReceive}\n\nEstado actual del proceso:\n- application_type: ${baseContext.application_type || 'sin nueva solicitud'}\n- credit_check_status: ${baseContext.credit_check_status || 'n/a'}\n- verification_status: ${baseContext.verification_status || 'n/a'}\n- signature: ${baseContext.signature !== null ? (baseContext.signature ? 'firmado' : 'pendiente') : 'n/a'}\n\nEste cliente ya liquidó su préstamo anterior y puede renovar. Guíalo hacia la app para que inicie su nueva solicitud si aún no lo ha hecho.`;\n\n} else {\n  // No hay oferta generada — cliente liquidado pero sin oferta lista\n  contextBlock = `CONTEXTO DEL CLIENTE (préstamo anterior LIQUIDADO — sin oferta de renovación)\n\nIdentidad:\n- Nombre: ${baseContext.first_name || 'no disponible'}\n- User ID: ${baseContext.user_id}\n- Email: ${baseContext.primary_email || 'no disponible'}\n- Último préstamo: ${baseContext.loan_number || 'n/a'} (liquidado)\n\nIMPORTANTE: Este cliente liquidó su préstamo pero aún no tiene una oferta de renovación generada. Puede ser porque:\n- Apenas liquidó y la oferta está por generarse\n- Su perfil no califica para renovación automática en este momento\n\nRespuesta sugerida: Felicitarlo por liquidar y pedirle que revise su app FinDemo en los próximos días. Si tiene dudas específicas sobre por qué no tiene oferta, escalar a un agente humano.`;\n}\n\nreturn [{\n  json: {\n    route_type: 'PAID_OFF',\n    daily_available: false,\n    has_offer: hasOffer,\n    context_block: contextBlock,\n    raw_offer: hasOffer ? offer : null,\n    base_context: baseContext,\n    should_escalate: false\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
