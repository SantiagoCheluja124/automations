  "nodes": [
    {
      "parameters": {
        "resource": "execution",
        "operation": "get",
        "executionId": "={{ $('Start').item.json.excecution_id }}",
        "options": {
          "activeWorkflows": true
        },
        "requestOptions": {}
      },
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "position": [
        416,
        0
      ],
      "id": "8ff6bab1-0071-4900-a590-8915c5b6ce59",
      "name": "Get an execution"
    },
    {
      "parameters": {
        "jsCode": "const exec = $input.first().json;\nconst runData = exec.data?.resultData?.runData || {};\nconst messageId = $('Start').first().json.message_id || null;\n// ── 1. conversation_id: buscarlo en el output del nodo trigger (Webhook)\nlet conversationId = null;\nfor (const runs of Object.values(runData)) {\n  for (const run of runs) {\n    const items = run.data?.main?.flat(2) || [];\n    for (const item of items) {\n      if (item?.json?.conversation_id != null) {\n        conversationId = String(item.json.conversation_id);\n        break;\n      }\n    }\n    if (conversationId) break;\n  }\n  if (conversationId) break;\n}\n\n// ── 2. root_execution_id: subir la cadena de padres (llave por MENSAJE)\nconst parent = exec.data?.parentExecution;\nconst rootExecId =\n  parent?.executionContext?.parentExecutionId  // abuelo (si existe)\n  || parent?.executionId                        // padre\n  || exec.id;                                   // sin padres: esta misma\n\n// ── 3. Precios por millón de tokens (¡verifica tarifas vigentes!)\nconst PRICING = {\n  'gpt-5.4-mini':              { prompt: 0.75, completion: 4.50 }, // ← pon el real\n  'claude-haiku-4-5-20251001': { prompt: 1.00, completion: 5.00 }\n};\n\nconst NODE_MODEL = {\n  'OpenAI Chat Model': 'gpt-5.4-mini',\n  'Anthropic Chat Model': 'claude-haiku-4-5-20251001',\n  'Anthropic Chat Model1': 'claude-haiku-4-5-20251001'\n  // agrega aquí los nodos LLM del orquestador con su modelo\n};\n\n// ── 4. Recorrer todos los nodos LLM y sacar tokens\nconst byNode = [];\nfor (const [nodeName, runs] of Object.entries(runData)) {\n  for (const run of runs) {\n    const lmData = run.data?.ai_languageModel;\n    if (!lmData) continue;\n    for (const branch of lmData) {\n      for (const item of branch || []) {\n        const usage = item.json?.tokenUsageEstimate || item.json?.tokenUsage;\n        if (!usage) continue;\n\n        const model = NODE_MODEL[nodeName] || 'desconocido';\n        const price = PRICING[model] || { prompt: 0, completion: 0 };\n        const cost =\n          (usage.promptTokens || 0) / 1e6 * price.prompt +\n          (usage.completionTokens || 0) / 1e6 * price.completion;\n\n        byNode.push({\n          node: nodeName,\n          model,\n          promptTokens: usage.promptTokens || 0,\n          completionTokens: usage.completionTokens || 0,\n          totalTokens: usage.totalTokens || 0,\n          cost_usd: Math.round(cost * 1e6) / 1e6\n        });\n      }\n    }\n  }\n}\n\n// ── 5. Una fila por nodo LLM\nconst fecha = (exec.stoppedAt || exec.startedAt || '').slice(0, 10);\n\nreturn byNode.map(r => ({\n  json: {\n    //fecha,\n    conversation_id: conversationId,\n    message_key: messageId || rootExecId,\n    execution_id: exec.id,\n    workflow_name: exec.workflowData?.name || 'desconocido',\n    ...r\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
